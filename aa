<html lang="ko">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>이차함수 탐구실</title>
<style>
:root{color-scheme:light dark;--bg:light-dark(#f3f6fb,#101827);--panel:light-dark(#fff,#192335);--ink:light-dark(#17243b,#eef4ff);--muted:light-dark(#63718a,#a6b4ca);--line:light-dark(#dce4f0,#344258);--blue:light-dark(#2459d3,#82aaff);--soft:light-dark(#edf3ff,#202f49);--green:light-dark(#117a63,#64d6b3)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.5}.app{min-height:100vh;background:var(--bg);padding:clamp(16px,3vw,34px)}.wrap{max-width:1180px;margin:auto}.top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:22px}.eyebrow{color:var(--blue);font-weight:800;font-size:.78rem;letter-spacing:.12em}.top h1{margin:4px 0;font-size:clamp(1.55rem,3vw,2.3rem);letter-spacing:-.04em}.sub{color:var(--muted);margin:0}.pill{border:1px solid var(--line);border-radius:999px;padding:8px 12px;color:var(--muted);font-size:.83rem;white-space:nowrap}.layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(290px,.85fr);gap:18px;align-items:start}.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:clamp(16px,2.2vw,24px);box-shadow:0 8px 28px #1020440a}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.panel h2{font-size:1.05rem;margin:0;letter-spacing:-.02em}.formula{background:var(--soft);border-radius:12px;padding:13px 16px;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.formula small{display:block;color:var(--muted);font-size:.75rem}.equation{font-size:clamp(1.25rem,3vw,1.7rem);font-weight:800;letter-spacing:-.04em;font-variant-numeric:tabular-nums}.graphbox{position:relative;width:100%;aspect-ratio:1.28;min-height:280px;max-height:510px}canvas{width:100%;height:100%;display:block;border-radius:12px}.legend{display:flex;gap:15px;flex-wrap:wrap;font-size:.8rem;color:var(--muted);margin-top:10px}.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px;background:#4c83ff}.dot.orange{background:#f59e0b}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.metric{background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px}.metric .label{font-size:.78rem;color:var(--muted)}.metric strong{display:block;font-size:1.08rem;margin-top:3px;overflow-wrap:anywhere}.controls{display:grid;gap:19px}.control-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px}.var{display:flex;align-items:center;gap:9px;font-weight:800}.var-chip{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:var(--soft);color:var(--blue)}.value{font-variant-numeric:tabular-nums;font-weight:800;font-size:1rem}.range{width:100%;accent-color:var(--blue);cursor:pointer}.ends{display:flex;justify-content:space-between;color:var(--muted);font-size:.72rem}.hint{font-size:.78rem;color:var(--muted);margin:5px 0 0}.btn{border:1px solid var(--line);border-radius:10px;background:var(--panel);color:var(--ink);padding:9px 13px;font-weight:700;cursor:pointer}.btn:hover{border-color:var(--blue)}.missions{margin-top:18px}.mission-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px}.mission{border:1px solid var(--line);border-radius:14px;padding:15px;background:var(--panel)}.mission-num{color:var(--blue);font-size:.78rem;font-weight:900;letter-spacing:.1em}.mission h3{font-size:.96rem;margin:6px 0}.mission p{font-size:.85rem;color:var(--muted);margin:0 0 12px}.mission label{display:flex;align-items:flex-start;gap:8px;font-size:.82rem;cursor:pointer}.mission input{accent-color:var(--green);margin-top:4px;flex-shrink:0}.foot{color:var(--muted);font-size:.78rem;margin-top:16px;text-align:center}.status{font-size:.8rem;color:var(--green);font-weight:700}
@media(max-width:800px){.layout{grid-template-columns:1fr}.mission-grid{grid-template-columns:1fr}.mission{padding:14px}.graphbox{aspect-ratio:1.12;min-height:250px}.top{align-items:flex-start}.pill{display:none}}@media(min-width:801px){.controls-panel{position:sticky;top:14px}}
</style></head>
<body><main class="app"><div class="wrap">
<header class="top"><div><div class="eyebrow">MATH LAB · 탐구 활동</div><h1>이차함수 탐구실</h1><p class="sub">계수를 움직이며 포물선의 규칙을 발견해 보세요.</p></div><span class="pill">고등학교 수학 · 함수와 그래프</span></header>
<div class="layout"><section class="panel"><div class="panel-head"><h2>함수 그래프</h2><span class="status" id="direction">위로 열린 포물선</span></div><div class="formula"><div><small>현재 함수식</small><div class="equation" id="equation">y = x²</div></div><button class="btn" id="reset">초기화</button></div>
<div class="graphbox"><canvas id="graph" aria-label="이차함수 그래프와 꼭짓점"></canvas></div><div class="legend"><span><i class="dot"></i> y = ax² + bx + c</span><span><i class="dot orange"></i> 꼭짓점</span><span>점선: 대칭축</span></div>
<div class="metrics"><div class="metric"><span class="label">꼭짓점</span><strong id="vertex">(0, 0)</strong></div><div class="metric"><span class="label">대칭축</span><strong id="axis">x = 0</strong></div><div class="metric"><span class="label">열리는 방향</span><strong id="opening">위쪽 ↑</strong></div><div class="metric"><span class="label">판별식 D = b² − 4ac</span><strong id="disc">0</strong></div></div></section>
<aside class="panel controls-panel"><div class="panel-head"><h2>계수 조절하기</h2><span class="pill">실시간 반영</span></div><div class="controls">
<div><div class="control-top"><div class="var"><span class="var-chip">a</span>이차항의 계수</div><span class="value" id="av">1.0</span></div><input class="range" id="a" type="range" min="-3" max="3" step="0.1" value="1" aria-label="a 계수"><div class="ends"><span>−3</span><span>0</span><span>3</span></div><p class="hint">그래프의 열리는 방향과 폭에 영향을 줘요.</p></div>
<div><div class="control-top"><div class="var"><span class="var-chip">b</span>일차항의 계수</div><span class="value" id="bv">0.0</span></div><input class="range" id="b" type="range" min="-6" max="6" step="0.1" value="0" aria-label="b 계수"><div class="ends"><span>−6</span><span>0</span><span>6</span></div><p class="hint">꼭짓점의 좌우 위치를 바꾸는 데 영향을 줘요.</p></div>
<div><div class="control-top"><div class="var"><span class="var-chip">c</span>상수항</div><span class="value" id="cv">0.0</span></div><input class="range" id="c" type="range" min="-8" max="8" step="0.1" value="0" aria-label="c 계수"><div class="ends"><span>−8</span><span>0</span><span>8</span></div><p class="hint">그래프가 y축과 만나는 위치를 바꿔요.</p></div></div></aside></div>
<section class="panel missions"><div class="panel-head"><div><h2>관찰 미션</h2><p class="sub" style="font-size:.85rem;margin-top:4px">슬라이더를 움직이고, 관찰한 미션을 체크해 보세요.</p></div><span class="pill" id="progress">0 / 3 완료</span></div><div class="mission-grid">
<article class="mission"><div class="mission-num">MISSION 01</div><h3>a의 부호와 방향</h3><p>a를 양수에서 음수로 바꿔 보세요. 포물선의 열리는 방향과 꼭짓점은 어떻게 달라지나요?</p><label><input type="checkbox" class="done"> 관찰을 마쳤어요</label></article>
<article class="mission"><div class="mission-num">MISSION 02</div><h3>b와 대칭축</h3><p>a와 c를 고정하고 b만 바꿔 보세요. 대칭축 x = −b/(2a)는 어느 방향으로 움직이나요?</p><label><input type="checkbox" class="done"> 관찰을 마쳤어요</label></article>
<article class="mission"><div class="mission-num">MISSION 03</div><h3>c와 y절편</h3><p>a와 b를 고정하고 c를 바꿔 보세요. 그래프가 y축과 만나는 점과 꼭짓점의 높이는 어떻게 변하나요?</p><label><input type="checkbox" class="done"> 관찰을 마쳤어요</label></article>
</div></section><p class="foot">탐구 팁: 한 번에 하나의 계수만 바꾸면 변화의 원인을 더 쉽게 찾을 수 있어요.</p></div></main>
<script>
(()=>{const $=id=>document.getElementById(id), canvas=$('graph'),ctx=canvas.getContext('2d');let a=1,b=0,c=0;const fmt=n=>{if(Math.abs(n)<0.0005)n=0;return Number(n.toFixed(2)).toString()};
function equation(){let s='y = ';const terms=[];function add(v,sym,power){if(Math.abs(v)<1e-9)return;let abs=Math.abs(v),coef=(power===2&&Math.abs(abs-1)<1e-9)||(power===1&&Math.abs(abs-1)<1e-9)?'':fmt(abs);let term=coef+sym;terms.push({sign:v<0?'−':'+',term});}add(a,'x²',2);add(b,'x',1);if(Math.abs(c)>1e-9)terms.push({sign:c<0?'−':'+',term:fmt(Math.abs(c))});if(!terms.length)s+='0';else terms.forEach((t,i)=>{s+=(i===0?(t.sign==='−'?'−':''):(' '+t.sign+' '))+t.term});return s}
function draw(){const rect=canvas.getBoundingClientRect(),dpr=Math.min(window.devicePixelRatio||1,2);canvas.width=Math.round(rect.width*dpr);canvas.height=Math.round(rect.height*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);const w=rect.width,h=rect.height;const dark=matchMedia('(prefers-color-scheme: dark)').matches;const colors={grid:dark?'#2c3a50':'#e7edf6',axis:dark?'#8292aa':'#8795aa',text:dark?'#a6b4ca':'#65748b',curve:dark?'#82aaff':'#2459d3',vertex:'#f59e0b'};ctx.clearRect(0,0,w,h);const xmin=-8,xmax=8,ymin=-10,ymax=10;const X=x=>((x-xmin)/(xmax-xmin))*w,Y=y=>h-((y-ymin)/(ymax-ymin))*h;
ctx.lineWidth=1;ctx.strokeStyle=colors.grid;ctx.fillStyle=colors.text;ctx.font='11px system-ui';for(let x=xmin;x<=xmax;x++){ctx.beginPath();ctx.moveTo(X(x),0);ctx.lineTo(X(x),h);ctx.stroke();if(x%2===0&&x!==0)ctx.fillText(x,X(x)+4,Y(0)+15)}for(let y=ymin;y<=ymax;y+=2){ctx.beginPath();ctx.moveTo(0,Y(y));ctx.lineTo(w,Y(y));ctx.stroke();if(y!==0)ctx.fillText(y,X(0)+6,Y(y)-4)}ctx.strokeStyle=colors.axis;ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(0,Y(0));ctx.lineTo(w,Y(0));ctx.moveTo(X(0),0);ctx.lineTo(X(0),h);ctx.stroke();ctx.fillStyle=colors.text;ctx.fillText('x',w-14,Y(0)-8);ctx.fillText('y',X(0)+7,13);
if(Math.abs(a)>1e-8){const xv=-b/(2*a),yv=a*xv*xv+b*xv+c;if(xv>=xmin&&xv<=xmax){ctx.save();ctx.setLineDash([5,5]);ctx.strokeStyle=colors.vertex;ctx.globalAlpha=.8;ctx.beginPath();ctx.moveTo(X(xv),0);ctx.lineTo(X(xv),h);ctx.stroke();ctx.restore()}ctx.strokeStyle=colors.curve;ctx.lineWidth=2.8;ctx.lineJoin='round';ctx.beginPath();let started=false;for(let px=0;px<=w;px+=1.5){let x=xmin+(px/w)*(xmax-xmin),y=a*x*x+b*x+c;if(y<ymin-2||y>ymax+2){started=false;continue}if(!started){ctx.moveTo(px,Y(y));started=true}else ctx.lineTo(px,Y(y))}ctx.stroke();if(xv>=xmin&&xv<=xmax&&yv>=ymin&&yv<=ymax){ctx.fillStyle=colors.vertex;ctx.beginPath();ctx.arc(X(xv),Y(yv),5.5,0,Math.PI*2);ctx.fill();ctx.strokeStyle=dark?'#192335':'white';ctx.lineWidth=2;ctx.stroke()}}
$('equation').textContent=equation();$('av').textContent=fmt(a);$('bv').textContent=fmt(b);$('cv').textContent=fmt(c);if(Math.abs(a)<1e-8){$('vertex').textContent='이차함수가 아님';$('axis').textContent='정의되지 않음';$('opening').textContent='포물선 아님';$('direction').textContent='a = 0 · 일차함수';}else{const xv=-b/(2*a),yv=c-(b*b)/(4*a);$('vertex').textContent=`(${fmt(xv)}, ${fmt(yv)})`;$('axis').textContent=`x = ${fmt(xv)}`;$('opening').textContent=a>0?'위쪽 ↑':'아래쪽 ↓';$('direction').textContent=a>0?'위로 열린 포물선':'아래로 열린 포물선'}$('disc').textContent=fmt(b*b-4*a*c)}
function update(){a=+$('a').value;b=+$('b').value;c=+$('c').value;draw()}['a','b','c'].forEach(id=>$(id).addEventListener('input',update));$('reset').addEventListener('click',()=>{$('a').value=1;$('b').value=0;$('c').value=0;update()});document.querySelectorAll('.done').forEach(el=>el.addEventListener('change',()=>{let n=[...document.querySelectorAll('.done')].filter(x=>x.checked).length;$('progress').textContent=`${n} / 3 완료`}));new ResizeObserver(draw).observe(canvas);window.matchMedia('(prefers-color-scheme: dark)').addEventListener?.('change',draw);update();})();
</script></body></html>
